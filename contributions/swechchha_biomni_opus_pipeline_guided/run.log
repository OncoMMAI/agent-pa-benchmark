Curated filtering leaves 33,145 unique triplets covering 676 kinases and 3,590 substrates. Next I'll derive heptameric peptides from the UniProt human proteome sequences. I'll only accept a peptide when the residue at the stated position matches the site, which also checks the site notation.

<execute>
r=requests.get("https://rest.uniprot.org/uniprotkb/stream?query=organism_id:9606&format=fasta",timeout=600)
seqs={};acc=None
for line in r.text.splitlines():
    if line.startswith('>'): acc=line.split('|')[1]; seqs[acc]=[]
    else: seqs[acc].append(line)
seqs={a:''.join(v) for a,v in seqs.items()}
print(len(seqs))
match=mism=nos=0
for e in rows.values():
    sq=seqs.get(e['substrate_uniprot'].split('-')[0]) if '-' not in e['substrate_uniprot'] else None
    res,pos=e['phospho_site'][0],int(e['phospho_site'][1:])
    if sq is None: nos+=1; continue
    if pos<=len(sq) and sq[pos-1]==res:
        pad='_'*3+sq+'_'*3
        e['heptameric_peptide']=pad[pos-1:pos+6]; match+=1
    else: mism+=1
print(match,mism,nos)
</execute>
