<execute>
curated={'PhosphoSite','SIGNOR','HPRD','phosphoELM','KEA','PhosphoNetworks','dbPTM','Li2012','NCI-PID_ProtMapper','Reactome_ProtMapper','PhosphoSite_ProtMapper','SIGNOR_ProtMapper','PhosphoSite_MIMP','HPRD_MIMP','phosphoELM_MIMP'}
def base(s): return s.split('_')[0]
rows={}
for r in p.itertuples():
    srcs={base(s) for s in r.sources.split(';') if s in curated}
    if not srcs or pd.isna(r.residue_type) or pd.isna(r.residue_offset): continue
    k,s=str(r.enzyme_genesymbol).upper(),str(r.substrate_genesymbol).upper()
    if k in('NAN','') or s in('NAN',''): continue
    site=f"{r.residue_type}{int(r.residue_offset)}"
    key=(k,s,site)
    e=rows.setdefault(key,{'kinase_gene':k,'substrate_gene':s,'phospho_site':site,'substrate_uniprot':r.substrate.split('-')[0] if '-' not in r.substrate else r.substrate,'supporting_databases':set()})
    e['supporting_databases']|=srcs
print(len(rows), len({k[0] for k in rows}), len({k[1] for k in rows}))
</execute>
