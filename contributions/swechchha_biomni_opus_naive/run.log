SIGNOR downloads directly. Next I'll parse its phosphorylation rows (protein→protein, residue given) and merge any triplets not already in the atlas, tagging them as SIGNOR.

<execute>
three={'Ser':'S','Thr':'T','Tyr':'Y','His':'H'}
lines=rs.text.splitlines()
added=0; merged=0; skipped=0
for ln in lines:
    f=ln.split('\t')
    if len(f)<12 or f[9]!='phosphorylation' or f[1]!='protein' or f[5]!='protein': continue
    res=f[10].strip()
    if not res or res[:3] not in three or not res[3:].isdigit(): skipped+=1; continue
    site=three[res[:3]]+res[3:]
    k,s,acc=f[0],f[4],f[6]
    key=(k,s,site)
    p=pep(acc,site[0],int(site[1:])) if acc in seqs else None
    if p is None and len(f[11])==15: p=f[11][4:11].upper()
    if key in agg:
        agg[key]["supporting_databases"].add("SIGNOR"); merged+=1
        if not agg[key]["heptameric_peptide"] and p: agg[key]["heptameric_peptide"]=p
    else:
        agg[key]={"kinase_gene":k,"substrate_gene":s,"phospho_site":site,"heptameric_peptide":p,
                  "substrate_uniprot":acc,"supporting_databases":{"SIGNOR"}}; added+=1
print("merged",merged,"added",added,"skipped",skipped)
entries=[]
for e in agg.values():
    e=dict(e); e["supporting_databases"]=sorted(e["supporting_databases"]); entries.append(e)
print(len(entries), sum(1 for e in entries if e["heptameric_peptide"]))
</execute>
