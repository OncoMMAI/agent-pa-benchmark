All 3,820 substrate sequences were retrieved. Next I'll build the entries: compute ±3 peptides only where the residue matches UniProt, keep mismatched entries without a peptide, and collapse duplicates.

<execute>
def pep(acc,aa,pos):
    s=seqs.get(acc)
    if not s or pos<1 or pos>len(s) or s[pos-1]!=aa: return None
    p=''.join(s[j-1] if 1<=j<=len(s) else '_' for j in range(pos-3,pos+4))
    return p
agg={}
mism=0
for row in df.itertuples():
    site=f"{row.residue_type}{int(row.residue_offset)}"
    key=(row.enzyme_genesymbol,row.substrate_genesymbol,site)
    p=pep(row.substrate,row.residue_type,int(row.residue_offset))
    if p is None: mism+=1
    e=agg.setdefault(key,{"kinase_gene":row.enzyme_genesymbol,"substrate_gene":row.substrate_genesymbol,"phospho_site":site,
        "heptameric_peptide":p,"substrate_uniprot":row.substrate,"supporting_databases":set()})
    if e["heptameric_peptide"] is None and p: e["heptameric_peptide"]=p
    e["supporting_databases"].update(row.sources.split(';'))
entries=[]
for e in agg.values():
    e=dict(e); e["supporting_databases"]=sorted(e["supporting_databases"]); entries.append(e)
print(len(entries), "residue mismatches:", mism)
print(entries[0])
</execute>
