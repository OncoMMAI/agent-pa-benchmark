Now I'll parse and merge. SIGNOR: keep human rows (taxid 9606) and split multi-site residues. OmniPath: keep its per-row source lists. Then I'll merge on (kinase, substrate, site).

<execute>
import re
aa = {"Ser":"S","Thr":"T","Tyr":"Y","His":"H"}
atlas = {}
def add(k,s,site,pep,up,src):
    key=(k.upper(),s.upper(),site)
    e=atlas.setdefault(key,{"kinase_gene":key[0],"substrate_gene":key[1],"phospho_site":site,"heptameric_peptide":"","substrate_uniprot":"","supporting_databases":set()})
    if pep and not e["heptameric_peptide"]: e["heptameric_peptide"]=pep
    if up and not e["substrate_uniprot"]: e["substrate_uniprot"]=up
    e["supporting_databases"].update(src)

ph = ph[(ph[12]=="9606") & (ph[1]=="protein") & (ph[5]=="protein")]
nsig=0
for _,r in ph.iterrows():
    if pd.isna(r[10]): continue
    res=str(r[10]).split(";"); peps=str(r[11]).split(";") if pd.notna(r[11]) else [""]*len(res)
    for i,x in enumerate(res):
        m=re.match(r"(Ser|Thr|Tyr|His)(\d+)$",x.strip())
        if not m: continue
        pep=peps[i].strip().upper() if i<len(peps) else ""
        add(r[0],r[4],aa[m.group(1)]+m.group(2),pep,r[6],{"SIGNOR"}); nsig+=1
print("SIGNOR site rows:",nsig,"atlas:",len(atlas))

for _,r in omni.dropna(subset=["enzyme_genesymbol","substrate_genesymbol","residue_offset"]).iterrows():
    srcs={x.split("_")[0] for x in r["sources"].split(";")}
    srcs={"PhosphoSitePlus" if x=="PhosphoSite" else ("UniProt" if x.startswith("UniProt") else x) for x in srcs}
    add(r["enzyme_genesymbol"],r["substrate_genesymbol"],r["residue_type"]+str(int(float(r["residue_offset"]))),"",r["substrate"],srcs)
print("atlas:",len(atlas))
from collections import Counter
c=Counter(d for e in atlas.values() for d in e["supporting_databases"]); print(c)
print("kinases:",len({e['kinase_gene'] for e in atlas.values()}), "multi-source:",sum(len(e['supporting_databases'])>1 for e in atlas.values()))
</execute>
